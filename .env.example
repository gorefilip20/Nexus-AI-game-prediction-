# ---------------------------------------------------------------------------
# Sports data provider
# ---------------------------------------------------------------------------
# API-Sports is the only affordable provider covering football, basketball AND
# volleyball behind a single key. Free tier: 100 requests/day per sport, reset
# at 00:00 UTC. Register at https://dashboard.api-football.com/register
#
# With no key set, the app runs on bundled sample data and labels it on screen.
API_SPORTS_KEY=

# 'direct'   -> *.api-sports.io      with x-apisports-key   (default)
# 'rapidapi' -> *.p.rapidapi.com     with x-rapidapi-key
API_SPORTS_MODE=direct

# Fixtures pulled per sport per refresh. Each one costs an extra odds request,
# so 3 keeps a full board inside the free tier.
FIXTURES_PER_SPORT=3

# Restrict odds to a single bookmaker id (optional; smaller, comparable payloads)
API_SPORTS_BOOKMAKER=

# ---------------------------------------------------------------------------
# Probability engine
# ---------------------------------------------------------------------------
# Costs one league-history request per league-season per refresh window.
# Set false to run the board on bookmaker odds alone.
MODEL_ENABLED=true

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Where settled picks are recorded (defaults to server/data/ledger.json)
LEDGER_PATH=

# How often pending picks are graded against finished fixtures
SETTLEMENT_INTERVAL_MS=900000

# ---------------------------------------------------------------------------
# Cache TTLs (protect the daily quota)
# ---------------------------------------------------------------------------
CACHE_FIXTURES_TTL_MS=300000
CACHE_ODDS_TTL_MS=900000
CACHE_RESULTS_TTL_MS=600000
CACHE_HISTORY_TTL_MS=21600000
