# =============================================================================
# NexusBet AI — environment template
# =============================================================================
# Copy to `.env` and fill in. `.env` is gitignored; this file is the only one
# committed, so it must never contain a real credential.
#
#   cp .env.example .env
#
# In production, prefer your platform's secret store over a .env file on disk:
#   AWS            Secrets Manager / SSM Parameter Store, injected as env vars
#   DigitalOcean   App Platform -> Settings -> App-Level Environment Variables,
#                  marked SECRET so they are encrypted at rest
#   Docker         --env-file, or Docker/Swarm secrets mounted at runtime
#
# SECURITY — read before adding any variable:
#
#   Anything prefixed VITE_ is INLINED INTO THE BROWSER BUNDLE and is public.
#   Never put an API key, database URL, or any secret behind a VITE_ prefix.
#   Only non-sensitive values (public URLs, feature flags) belong there.
#   `npm run check:secrets` enforces this and refuses to let such a build ship.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Comma-separated browser origins allowed to call the API.
# In production set this to your real domain — never leave it as "*".
CORS_ORIGIN=http://localhost:5173

# Set true when running behind a load balancer or reverse proxy (AWS ALB,
# DigitalOcean App Platform, nginx) so client IPs and protocol are read from
# X-Forwarded-* instead of the proxy's own socket.
TRUST_PROXY=false

# Serve the built client from the API process (single origin, no CORS needed).
SERVE_CLIENT=false

# -----------------------------------------------------------------------------
# Sports data provider  [SECRET]
# -----------------------------------------------------------------------------
# API-Sports covers football, basketball and volleyball behind one key.
# Free tier: 100 requests/day per sport. https://dashboard.api-football.com/register
# Leave empty to run on bundled sample data.
API_SPORTS_KEY=

# 'direct' -> *.api-sports.io (x-apisports-key) | 'rapidapi' -> RapidAPI host
API_SPORTS_MODE=direct

FIXTURES_PER_SPORT=3
API_SPORTS_BOOKMAKER=

# -----------------------------------------------------------------------------
# Database  [SECRET]
# -----------------------------------------------------------------------------
# NOT YET WIRED. The prediction ledger currently persists to a JSON file at
# LEDGER_PATH. That file does not survive an ephemeral container, so moving the
# ledger to a database is the prerequisite for horizontal scaling — see
# DEPLOYMENT.md, "Persistence".
#
# When you add one, put the URL here and never in a VITE_ variable:
# DATABASE_URL=postgresql://user:password@host:5432/nexusbet?sslmode=require
# DATABASE_POOL_MAX=10

# Where settled picks are recorded until then. Point at a mounted volume in
# production, not container-local disk.
LEDGER_PATH=

# -----------------------------------------------------------------------------
# Outbound egress  [SECRET if it carries credentials]
# -----------------------------------------------------------------------------
# ONE stable proxy for all provider traffic — not a rotating pool.
#
# The provider's quota is bound to your API key, so rotating IPs cannot buy a
# single extra request, and its abuse protection weighs the source IP alongside
# the key: a churn of addresses on one key lowers effective capacity. API-Sports
# recommends a dedicated static IP for production. See PROXY_AND_QUOTA.md.
#
# Set this when you have a real reason: an allowlisted NAT gateway, a corporate
# egress proxy, or pinning traffic to one region. Leave empty for direct.
EGRESS_PROXY_URL=
EGRESS_KEEPALIVE_MS=30000

# -----------------------------------------------------------------------------
# Request budget
# -----------------------------------------------------------------------------
# Paces the daily allowance across the UTC day and reserves capacity for
# settlement and in-play fixtures. Set the limit to match your actual plan.
QUOTA_ENABLED=true
QUOTA_DAILY_LIMIT=100

# -----------------------------------------------------------------------------
# Settlement notifications  [SECRET]
# -----------------------------------------------------------------------------
# A card is sent when a recorded pick settles. Leave everything blank to
# disable; a half-configured channel is skipped rather than half-enabled.
#
# Telegram: create a bot with @BotFather, add it to your channel as an admin,
# then use the channel id (e.g. -1001234567890) as the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Any HTTPS endpoint receiving the structured JSON payload — Slack, Discord,
# or your own push relay.
NOTIFY_WEBHOOK_URL=

# Which settlement outcomes fire a card. WIN only by default; add LOSS for a
# complete feed rather than a wins-only highlight reel.
NOTIFY_STATUSES=WIN

# -----------------------------------------------------------------------------
# Coverage — which competitions appear on the board
# -----------------------------------------------------------------------------
# Days ahead to sweep (1 = today's card, as a book shows by default).
COVERAGE_DAYS=1

# Pages per listing. The provider pages at 100, so 10 covers ~1000 fixtures.
COVERAGE_MAX_PAGES=10
COVERAGE_MAX_FIXTURES=200

# Women's competitions are covered by default across all three sports.
# Turning this off must be a deliberate choice.
COVERAGE_INCLUDE_WOMENS=true

# Youth and reserve competitions are off by default, matching what books carry.
COVERAGE_INCLUDE_YOUTH=false
COVERAGE_INCLUDE_FRIENDLIES=true

# Comma-separated league ids. Leave empty for every league the provider returns.
COVERAGE_LEAGUES=
COVERAGE_EXCLUDE_LEAGUES=

# -----------------------------------------------------------------------------
# Confidence filter
# -----------------------------------------------------------------------------
# Flags picks the model rates at least this likely (percent). Every fixture
# still appears; this only marks the confident subset.
#
# Measure the right value with `npm run backtest` against a real league. On a
# well-specified sample, a 75% filter produced an ~82% strike rate on ~23% of
# fixtures. A high strike rate is NOT profit: favourites at that level price
# near 1.20, where roughly 83% is break-even.
MIN_CONFIDENCE=0

# -----------------------------------------------------------------------------
# Probability engine
# -----------------------------------------------------------------------------
MODEL_ENABLED=true
SETTLEMENT_INTERVAL_MS=900000

# -----------------------------------------------------------------------------
# Rate limiting (per IP)
# -----------------------------------------------------------------------------
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# -----------------------------------------------------------------------------
# Cache TTLs — these protect the daily provider quota. Raising them lowers cost.
# -----------------------------------------------------------------------------
CACHE_FIXTURES_TTL_MS=300000
CACHE_ODDS_TTL_MS=900000
CACHE_RESULTS_TTL_MS=600000
CACHE_HISTORY_TTL_MS=21600000

# -----------------------------------------------------------------------------
# Client build-time values — PUBLIC, inlined into the bundle. No secrets.
# -----------------------------------------------------------------------------
# VITE_API_TARGET=http://localhost:5000
# VITE_WS_URL=
