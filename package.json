{
  "name": "nexusbet-ai",
  "version": "0.1.0",
  "private": true,
  "description": "NexusBet AI - multi-sport analytics dashboard, streak tracker and real-time punter lounge",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "test": "npm run test --workspace server",
    "verify:provider": "node scripts/verify-provider.js",
    "scenario": "node scripts/scenario.js"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
