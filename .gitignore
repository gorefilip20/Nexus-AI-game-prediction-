node_modules/
dist/
build/

# Secrets. Only .env.example is tracked — it must contain placeholders, never
# real values. The negation keeps it from being swept up by the patterns above.
.env
.env.*
!.env.example

*.log
npm-debug.log*
.DS_Store
.vite/

# Prediction ledger (runtime data, not source)
server/data/

# Local process-manager and container state
.pm2/
*.pid
